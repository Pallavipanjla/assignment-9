extends layout

block content

  h1.edit-heading EDIT STUDENT

  form(action=`/edit/${student.id}?_method=PUT`, method='POST')

    .form-group
      label Name

      input(
        type='text',
        name='name',
        value=student.name,
        required
      )

    .form-group
      label Course

      input(
        type='text',
        name='course',
        value=student.course,
        required
      )

    .form-group
      label Marks

      input(
        type='number',
        name='marks',
        value=student.marks,
        required
      )

    button.btn.btn-edit(type='submit')

      i(class='fa-solid fa-rotate')

      |  Update Student